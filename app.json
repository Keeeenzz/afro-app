{
  "expo": {
    "name": "afro-app",
    "slug": "afro-app",
    "scheme": "afro-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/afro-logo-black.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/afro-logo-black.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "A'FRO uses your location to fill in your delivery address."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/afro-logo-black.png",
        "backgroundColor": "#000000"
      },
      "package": "com.anonymous.afroapp"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-notifications",
      "expo-location",
      "expo-image"
    ]
  }
}
